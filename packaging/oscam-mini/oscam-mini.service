[Unit]
Description=TVStreammerSAT5 OSCam-mini Newcamd/Phoenix server
After=network.target
Conflicts=oscam.service
ConditionPathExists=/opt/TVStreammerSAT5/oscam-mini/config/oscam.conf

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/TVStreammerSAT5/oscam-mini
ExecStart=/opt/TVStreammerSAT5/oscam-mini/oscam-mini -c /opt/TVStreammerSAT5/oscam-mini/config
SuccessExitStatus=15 SIGTERM
Restart=on-failure
RestartSec=2
Nice=5
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
